{
  "name": "death-real-fall",
  "description": "The player is dropped from 300 m and the game's own fall damage kills them; the death is reported",
  "timeout": 120,
  "steps": [
    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at"
    },
    {
      "do": "setConfig",
      "values": {
        "Player Deaths/Server - Webhook URL": "{{secret:VDR_TEST_WEBHOOK}}?wait=false",
        "Player Deaths/Client - Video Enabled": "false"
      }
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.dropPlayer",
      "args": {
        "meters": 300
      },
      "contains": "PASS",
      "label": "lifted high"
    },
    {
      "do": "wait",
      "seconds": 30
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.playerAlive",
      "expect": true,
      "label": "respawned and ready"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.lastDeath",
      "contains": "killer=none",
      "notContains": "{",
      "label": "fall death reported"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.cleanup"
    },
    {
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Death message sent to the death webhook",
      "label": "a death message was sent to Discord",
      "do": "check"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "ValheimDiscordRelay"
    }
  ]
}
