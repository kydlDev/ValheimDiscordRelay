    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.cleanup"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at",
      "label": "back on the arena spot"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killPlayerBy",
      "args": {
        "prefab": "SeekerQueen",
        "level": 1
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "SeekerQueen level 1: killed"
    },
    {
      "do": "wait",
      "seconds": 16
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.playerAlive",
      "expect": true,
      "label": "respawned and ready"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.lastDeath",
      "contains": "killer=SeekerQueen;level=1",
      "notContains": "{",
      "label": "SeekerQueen level 1: death message built"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.cleanup"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at",
      "label": "back on the arena spot"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killPlayerBy",
      "args": {
        "prefab": "Fader",
        "level": 1
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "Fader level 1: killed"
    },
    {
      "do": "wait",
      "seconds": 16
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.playerAlive",
      "expect": true,
      "label": "respawned and ready"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.lastDeath",
      "contains": "killer=Fader;level=1",
      "notContains": "{",
      "label": "Fader level 1: death message built"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.cleanup"
    },
    {
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Death message sent to the death webhook",
      "label": "a death message was sent to Discord",
      "do": "check"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "ValheimDiscordRelay"
    }
  ]
}
