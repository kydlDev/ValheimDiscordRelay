    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killPlayerBy",
      "args": {
        "prefab": "GoblinKing",
        "level": 1
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "GoblinKing level 1: killed"
    },
    {
      "do": "wait",
      "seconds": 16
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.playerAlive",
      "expect": true,
      "label": "respawned and ready"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.lastDeath",
      "contains": "killer=GoblinKing;level=1",
