    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at",
      "label": "back on the arena spot"
    },
    {
      "do": "setConfig",
      "values": {
        "Player Deaths/Server - Webhook URL": "{{secret:VDR_TEST_WEBHOOK}}?wait=false",
        "Player Deaths/Client - Video Enabled": "false"
      }
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killPlayerBy",
      "args": {
        "prefab": "Greyling",
        "level": 1
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "Greyling level 1: killed"
    },
    {
      "do": "wait",
      "seconds": 16
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.playerAlive",
      "expect": true,
      "label": "respawned and ready"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.lastDeath",
      "contains": "killer=Greyling;level=1",
