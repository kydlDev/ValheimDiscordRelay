{
  "name": "death-environment",
  "description": "Every environmental hit type (fall, drowning, Ashlands sea, crush kinds, fire, cold...) kills the player and is reported without a killer",
  "timeout": 1380,
  "steps": [
    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at",
      "label": "back on the arena spot"
    },
    {
      "do": "setConfig",
      "values": {
        "Player Deaths/Server - Webhook URL": "{{secret:VDR_TEST_WEBHOOK}}?wait=false",
        "Player Deaths/Client - Video Enabled": "false"
      }
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killPlayerEnv",
      "args": {
        "hitType": "Fall"
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "Fall: killed"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "valheimdiscordrelay.playerReady",
        "expect": 1
      },
      "timeout": 60
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.playerAlive",
      "expect": true,
      "label": "respawned and ready"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.lastDeath",
      "contains": "killer=none",
      "notContains": "{",
      "label": "Fall: death message built"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.cleanup"
    },
