      "name": "valheimdiscordrelay.cleanup"
    },
    {
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Death message sent to the death webhook",
      "label": "a death message was sent to Discord",
      "do": "check"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "ValheimDiscordRelay"
    }
  ]
}
