{
  "name": "boss-kills",
  "description": "The player kills every boss with one hit (video off); the mod detects the kill, shouts it in game chat and queues the message-only announcement for each",
  "timeout": 480,
  "steps": [
    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at"
    },
    {
      "do": "setConfig",
      "values": {
        "Player Deaths/Server - Webhook URL": "{{secret:VDR_TEST_WEBHOOK}}?wait=false",
        "Player Deaths/Client - Video Enabled": "false",
        "Boss Death/Server - Webhook URL": "{{secret:VDR_TEST_WEBHOOK}}?wait=false",
        "Boss Death/Client - Video Enabled": "false"
      }
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killBoss",
      "args": {
        "prefab": "Eikthyr"
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "Eikthyr: killed by the player"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Boss death detected. Prefab='Eikthyr'",
      "label": "Eikthyr: boss death detected",
      "do": "check"
    },
    {
      "do": "check",
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Boss death: prefab='Eikthyr'",
      "label": "Eikthyr: message sent without a video"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.cleanup"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killBoss",
      "args": {
        "prefab": "gd_king"
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "gd_king: killed by the player"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Boss death detected. Prefab='gd_king'",
      "label": "gd_king: boss death detected",
      "do": "check"
    },
    {
      "do": "check",
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Boss death: prefab='gd_king'",
      "label": "gd_king: message sent without a video"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.cleanup"
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.arena",
      "contains": "arena at"
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "valheimdiscordrelay.killBoss",
      "args": {
        "prefab": "Bonemass"
      },
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "Bonemass: killed by the player"
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "check": "logContains",
      "source": "ValheimDiscordRelay",
      "text": "Boss death detected. Prefab='Bonemass'",
      "label": "Bonemass: boss death detected",
